@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var isAdmin = HttpContextAccessor.HttpContext?.Session.GetString("Admin") != null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GezginNotları</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Light Theme (Varsayılan) */
            --bg-primary: #F9FAFB;
            --bg-secondary: #FFFFFF;
            --bg-card: #FFFFFF;
            --text-primary: #333333;
            --text-secondary: #6B7280;
            --text-muted: #9CA3AF;
            --border-color: #E5E7EB;
            --shadow-sm: rgba(0, 0, 0, 0.1);
            --shadow-md: rgba(0, 0, 0, 0.15);
            --navbar-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --footer-gradient: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            --hero-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --card-hover-shadow: rgba(0, 0, 0, 0.15);
        }

        [data-theme="dark"] {
            /* Dark Theme */
            --bg-primary: #0F172A;
            --bg-secondary: #1E293B;
            --bg-card: #1E293B;
            --text-primary: #F1F5F9;
            --text-secondary: #CBD5E1;
            --text-muted: #94A3B8;
            --border-color: #334155;
            --shadow-sm: rgba(0, 0, 0, 0.3);
            --shadow-md: rgba(0, 0, 0, 0.4);
            --navbar-gradient: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
            --footer-gradient: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            --hero-gradient: linear-gradient(135deg, #334155 0%, #1E293B 100%);
            --card-hover-shadow: rgba(0, 0, 0, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            color: var(--text-primary);
        }

        .navbar {
            background: var(--navbar-gradient);
            box-shadow: 0 2px 10px var(--shadow-sm);
            padding: 1rem 0;
            transition: background 0.3s ease;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.75rem;
            color: white !important;
            letter-spacing: 0.5px;
            font-family: 'Poppins', sans-serif;
        }

        .navbar-brand:hover {
            color: #f1c40f !important;
            transition: color 0.3s ease;
        }

        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 500;
            margin-right: 0.5rem;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
        }

        .nav-link:hover {
            color: white !important;
            background-color: rgba(255,255,255,0.1);
        }

        .btn-admin {
            background-color: #f1c40f;
            color: #2c3e50;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-admin:hover {
            background-color: #d4ac0d;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .btn-logout {
            background-color: #e74c3c;
            color: white;
            font-weight: 600;
            border: none;
        }

        .btn-logout:hover {
            background-color: #c0392b;
            color: white;
        }

        .btn-theme-toggle {
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 0.5rem 0.75rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            cursor: pointer;
            font-size: 1.1rem;
        }

        .btn-theme-toggle:hover {
            background-color: rgba(255, 255, 255, 0.3);
            transform: scale(1.05);
        }

        main {
            flex: 1;
            margin-bottom: 80px;
            margin-top: 1rem;
        }

        footer {
            background: var(--footer-gradient);
            color: #ecf0f1;
            padding: 1.5rem 0;
            text-align: center;
            font-size: 0.9rem;
            margin-top: auto;
            box-shadow: 0 -2px 10px var(--shadow-sm);
            transition: background 0.3s ease;
        }

        .hero-section {
            background: var(--hero-gradient);
            color: white;
            border-radius: 15px;
            padding: 4rem 2rem;
            margin: 2rem 0;
            box-shadow: 0 10px 30px var(--shadow-md);
            transition: background 0.3s ease;
        }

        /* Card Styling */
        .card {
            background: var(--bg-card);
            border-color: var(--border-color);
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        .card-title {
            color: var(--text-primary) !important;
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        .bg-secondary {
            background-color: var(--bg-secondary) !important;
        }

        /* Form Elements */
        .form-control, .form-select {
            background-color: var(--bg-secondary);
            border-color: var(--border-color);
            color: var(--text-primary);
        }

        .form-control:focus, .form-select:focus {
            background-color: var(--bg-secondary);
            border-color: #667eea;
            color: var(--text-primary);
        }

        .form-label {
            color: var(--text-primary);
        }

        .card-header {
            border-color: var(--border-color);
        }

        .border-top {
            border-color: var(--border-color) !important;
        }

        hr {
            border-color: var(--border-color);
        }

        @@media (max-width: 768px) {
            .hero-section {
                padding: 2.5rem 1.5rem;
            }
            
            .navbar-brand {
                font-size: 1.5rem;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Gunluk" asp-action="Index">
                <i class="bi bi-compass"></i> GezginNotları
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
                aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMenu">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Gunluk" asp-action="Index">
                            <i class="bi bi-house-door"></i> Anasayfa
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="About" asp-action="Index">
                            <i class="bi bi-info-circle"></i> Hakkında
                        </a>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-theme-toggle ms-2" id="themeToggle" aria-label="Tema Değiştir">
                            <i class="bi bi-sun-fill" id="themeIcon"></i>
                        </button>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gunluk" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Yeni Günlük
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-logout btn-sm ms-2" asp-controller="Admin" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Çıkış
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-admin btn-sm ms-2" asp-controller="Admin" asp-action="Login">
                                <i class="bi bi-shield-lock"></i> Admin Giriş
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p class="mb-0">&copy; 2026 MubilDesigns - Tüm hakları saklıdır</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Dark Mode Toggle Functionality
        (function() {
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            const html = document.documentElement;
            
            // localStorage'dan tema tercihini oku (varsayılan: light)
            const currentTheme = localStorage.getItem('theme') || 'light';
            
            // Tema uygula
            function applyTheme(theme) {
                if (theme === 'dark') {
                    html.setAttribute('data-theme', 'dark');
                    themeIcon.className = 'bi bi-moon-fill';
                } else {
                    html.setAttribute('data-theme', 'light');
                    themeIcon.className = 'bi bi-sun-fill';
                }
                localStorage.setItem('theme', theme);
            }
            
            // Sayfa yüklendiğinde tema uygula
            applyTheme(currentTheme);
            
            // Toggle butonuna tıklandığında
            themeToggle.addEventListener('click', function() {
                const currentTheme = html.getAttribute('data-theme') || 'light';
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                applyTheme(newTheme);
            });
        })();
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
